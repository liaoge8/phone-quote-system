# 复制为 .env 后按需修改
# 登录密码（与前端演示密码一致）
ADMIN_PASSWORD=8888
# JWT 签名密钥，生产环境务必换成随机长字符串
SECRET_KEY=change-me-in-production
# Token 有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 数据库：默认 SQLite；生产用远程 PostgreSQL 示例（密码里如有特殊字符需做 URL 编码）：
# DATABASE_URL=postgresql+psycopg2://用户名:密码@远程主机:5432/phone_quote?sslmode=require
# sslmode=require 保证连接加密；内网可信网络可去掉该参数
DATABASE_URL=sqlite:///./data.db
# 大模型：OpenAI 接口（key 从 OpenAI 后台获取，不要提交到仓库）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o-mini
